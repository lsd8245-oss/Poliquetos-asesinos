{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliquetos.local/schemas/worlds.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "nombre": {
        "type": "string",
        "minLength": 1
      },
      "acto": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4
      },
      "duracion_hasta_jefe_seg": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "enemigos_total": {
        "type": "integer",
        "minimum": 1
      },
      "alerta_jefe_seg": {
        "type": "number",
        "minimum": 0
      },
      "paleta": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "minItems": 1
      },
      "scroll_px_s": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "cancion_jefe": {
        "type": "string",
        "minLength": 1
      },
      "musica_etapa": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "musica_jefe": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "peligros": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "minItems": 0
      },
      "jefes": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "minItems": 1
      },
      "unicos": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "uniqueItems": true
      },
      "recurrentes": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "uniqueItems": true
      },
      "jefe_objetivo_seg": {
        "type": "number",
        "minimum": 0
      },
      "base_monedas": {
        "type": "integer",
        "minimum": 0
      },
      "semilla": {
        "type": "integer",
        "minimum": 0
      },
      "laboratorio_organicos": {
        "type": "integer",
        "minimum": 0
      },
      "laboratorio_roboticos": {
        "type": "integer",
        "minimum": 0
      },
      "sectores_jefes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "jefes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "uniqueItems": true
            },
            "objetivo_seg": {
              "type": "number",
              "minimum": 0
            },
            "base_monedas": {
              "type": "integer",
              "minimum": 0
            },
            "texto": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "jefes",
            "objetivo_seg",
            "base_monedas",
            "texto"
          ],
          "additionalProperties": false
        }
      },
      "legacy_id": {
        "type": "integer",
        "minimum": 1,
        "maximum": 14
      },
      "miniboss_enabled": {
        "const": false
      },
      "final_boss_enabled": {
        "const": true
      }
    },
    "required": [
      "id",
      "nombre",
      "acto",
      "duracion_hasta_jefe_seg",
      "enemigos_total",
      "alerta_jefe_seg",
      "paleta",
      "scroll_px_s",
      "cancion_jefe",
      "musica_etapa",
      "musica_jefe",
      "peligros",
      "jefes",
      "legacy_id",
      "miniboss_enabled",
      "final_boss_enabled",
      "unicos",
      "recurrentes"
    ],
    "additionalProperties": false
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliquetos.local/schemas/bosses.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "nombre": {
        "type": "string",
        "minLength": 1
      },
      "vida": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "tamano": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 2,
        "maxItems": 2
      },
      "segmentos": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "hitbox": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 4,
              "maxItems": 4
            },
            "debil": {
              "type": "boolean"
            },
            "mult_dano": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "id",
            "hitbox",
            "debil",
            "mult_dano"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "fases": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "desde_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "hasta_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "patrones": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "minItems": 1
            }
          },
          "required": [
            "desde_pct",
            "hasta_pct",
            "patrones"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "recompensa_extra": {
        "type": "integer",
        "minimum": 0
      },
      "objeto_unico": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "mundo": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "arquetipo": {
        "type": "string",
        "pattern": "^[a-z][a-zA-Z0-9_]*$"
      },
      "tipo": {
        "const": "jefe"
      },
      "objetivo_seg": {
        "type": "number",
        "minimum": 0
      },
      "minimo_seg": {
        "type": "number",
        "minimum": 0
      },
      "movimiento": {
        "enum": [
          "M1",
          "M2",
          "M3",
          "M4",
          "M5",
          "M6",
          "M7",
          "M8"
        ]
      },
      "disparo": {
        "enum": [
          "F0",
          "F1",
          "F2",
          "F3",
          "F4",
          "F5"
        ]
      },
      "drop_item": {
        "const": "arma_mas_baja"
      },
      "parametros": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0
        }
      },
      "vida_base": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "asset_id": {
        "type": "string",
        "pattern": "^boss_w[0-9]{2}_[a-z0-9_]+$"
      },
      "asset_world": {
        "type": "integer",
        "minimum": 1,
        "maximum": 14
      }
    },
    "required": [
      "id",
      "nombre",
      "vida",
      "tamano",
      "segmentos",
      "fases",
      "recompensa_extra",
      "objeto_unico",
      "mundo",
      "tipo",
      "asset_id",
      "asset_world"
    ],
    "additionalProperties": false
  },
  "minItems": 1,
  "examples": [
    [
      {
        "id": "boss_w01_nereis",
        "nombre": "Nereidae",
        "mundo": 1,
        "arquetipo": "nereis",
        "tipo": "jefe",
        "vida": 2319,
        "objetivo_seg": 90,
        "minimo_seg": 36.0,
        "tamano": [
          180,
          120
        ],
        "segmentos": [
          {
            "id": "cabeza",
            "hitbox": [
              0,
              36.0,
              45.0,
              48.0
            ],
            "debil": true,
            "mult_dano": 2
          },
          {
            "id": "cuerpo",
            "hitbox": [
              45.0,
              0,
              135.0,
              120
            ],
            "debil": false,
            "mult_dano": 0.5
          }
        ],
        "fases": [
          {
            "desde_pct": 100,
            "hasta_pct": 66,
            "patrones": [
              "ondular_vertical",
              "balas_apuntadas_3"
            ]
          },
          {
            "desde_pct": 66,
            "hasta_pct": 33,
            "patrones": [
              "faringe_embestida",
              "abanico_5"
            ]
          },
          {
            "desde_pct": 33,
            "hasta_pct": 0,
            "patrones": [
              "dividir_en_dos",
              "anillo_12"
            ]
          }
        ],
        "recompensa_extra": 0,
        "objeto_unico": null,
        "parametros": {
          "intervalo": 2,
          "telegraph": 0.5,
          "velocidad": 80,
          "entrada_seg": 3,
          "derrota_seg": 3,
          "invulnerabilidad_fase_seg": 3,
          "furia_cadencia": 1.3,
          "furia_velocidad": 1.3,
          "polyn_apertura_seg": 4,
          "tomo_visibilidad_seg": 2,
          "destello_seg": 0.3,
          "estalactita_aviso_seg": 0.7,
          "congelacion_seg": 1,
          "lava_subida_seg": 10,
          "hermo_anillo_seg": 5,
          "mucosidad_lento": 0.3
        },
        "vida_base": 1750,
        "asset_id": "boss_w01_nereis",
        "asset_world": 1
      }
    ]
  ]
}

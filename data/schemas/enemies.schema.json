{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliquetos.local/schemas/enemies.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "familia": {
        "type": "string",
        "minLength": 1
      },
      "tipo": {
        "type": "string",
        "minLength": 1
      },
      "categoria": {
        "enum": [
          "enjambre",
          "pequeno",
          "mediano",
          "escolta"
        ]
      },
      "mundos": {
        "type": "object",
        "minProperties": 1,
        "patternProperties": {
          "^([1-9]|1[0-2])$": {
            "type": "object",
            "properties": {
              "rol": {
                "enum": [
                  "unico",
                  "recurrente"
                ]
              },
              "sprite_set": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "runtime_ready": {
                "type": "boolean"
              }
            },
            "required": [
              "rol",
              "sprite_set",
              "runtime_ready"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "movimiento": {
        "enum": [
          "M1",
          "M2",
          "M3",
          "M4",
          "M5",
          "M6",
          "M7",
          "M8"
        ]
      },
      "disparo": {
        "enum": [
          "F0",
          "F1",
          "F2",
          "F3",
          "F4",
          "F5"
        ]
      },
      "puntos": {
        "type": "integer",
        "minimum": 0
      },
      "drop": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "estado": {
        "enum": [
          "revisar",
          "confirmado",
          "pendiente"
        ]
      },
      "tamano": {
        "type": "array",
        "items": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minItems": 2,
        "maxItems": 2
      },
      "blindado": {
        "type": "boolean"
      },
      "robot_codigo": {
        "enum": [
          "R1",
          "R2",
          "R3",
          "R4",
          "R5",
          "R6"
        ]
      },
      "parametros": {
        "type": "object",
        "properties": {
          "carcasa_abierta_seg": {
            "type": "number",
            "minimum": 0
          },
          "cadena_intervalo_seg": {
            "type": "number",
            "minimum": 0
          },
          "carcasa_periodo_seg": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "carcasa_abierta_seg",
          "cadena_intervalo_seg"
        ],
        "additionalProperties": false
      },
      "runtime_ready": {
        "type": "boolean"
      },
      "pending": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "required": [
      "id",
      "familia",
      "tipo",
      "mundos",
      "estado",
      "runtime_ready"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "runtime_ready": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "categoria",
            "movimiento",
            "disparo",
            "puntos",
            "drop",
            "tamano"
          ]
        },
        "else": {
          "required": [
            "pending"
          ],
          "properties": {
            "estado": {
              "const": "pendiente"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "movimiento"
                ]
              },
              {
                "required": [
                  "disparo"
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "minItems": 1,
  "examples": [
    [
      {
        "id": "hydroides",
        "familia": "Hydroides · Serpulidae",
        "tipo": "tubicola",
        "categoria": "mediano",
        "mundos": {
          "1": {
            "rol": "unico",
            "sprite_set": "w01_enemy_hydroides",
            "runtime_ready": true
          },
          "12": {
            "rol": "recurrente",
            "sprite_set": "w12_enemy_hydroides",
            "runtime_ready": true
          }
        },
        "movimiento": "M5",
        "disparo": "F3",
        "tamano": [
          48,
          48
        ],
        "puntos": 100,
        "drop": {
          "moneda_chica": 0.35,
          "moneda_grande": 0.05
        },
        "estado": "revisar",
        "blindado": false,
        "parametros": {
          "carcasa_abierta_seg": 1,
          "cadena_intervalo_seg": 0.15
        },
        "runtime_ready": true
      },
      {
        "id": "eulalia",
        "familia": "Eulalia · Phyllodocidae",
        "tipo": "pendiente",
        "mundos": {
          "1": {
            "rol": "unico",
            "sprite_set": "w01_enemy_eulalia",
            "runtime_ready": false
          }
        },
        "estado": "pendiente",
        "runtime_ready": false,
        "pending": [
          "original_png_and_atlas",
          "accepted_behavior_and_balance"
        ]
      }
    ]
  ]
}

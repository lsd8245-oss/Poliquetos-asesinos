{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poliquetos.local/schemas/waves.schema.json",
  "type": "object",
  "properties": {
    "mundo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "eventos": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0
              },
              "tipo": {
                "const": "oleada"
              },
              "enemigo": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "cantidad": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "formacion": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "portadora": {
                "type": "boolean"
              },
              "item": {
                "enum": [
                  "rojo",
                  "verde",
                  "azul",
                  "amarillo"
                ]
              },
              "separacion_px": {
                "type": "number",
                "minimum": 0
              },
              "separacion_seg": {
                "type": "number",
                "minimum": 0
              },
              "legacy_index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "t",
              "tipo",
              "enemigo",
              "cantidad",
              "formacion",
              "y",
              "legacy_index"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "portadora": {
                      "const": true
                    }
                  },
                  "required": [
                    "portadora"
                  ]
                },
                "then": {
                  "required": [
                    "item"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0
              },
              "tipo": {
                "const": "alerta_jefe"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "jefes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "uniqueItems": true
              },
              "legacy_index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "t",
              "tipo",
              "id",
              "legacy_index"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0
              },
              "tipo": {
                "const": "escudo"
              },
              "item": {
                "const": "amarillo"
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "legacy_index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "t",
              "tipo",
              "item",
              "y",
              "legacy_index"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0
              },
              "tipo": {
                "const": "peligro"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "duracion_seg": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "legacy_index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "t",
              "tipo",
              "id",
              "duracion_seg",
              "y",
              "legacy_index"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "semilla": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "mundo",
    "eventos"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "mundo": 1,
      "semilla": 0,
      "eventos": [
        {
          "t": 10.0,
          "tipo": "oleada",
          "enemigo": "hydroides",
          "cantidad": 4,
          "formacion": "linea_vertical",
          "y": 60,
          "portadora": true,
          "separacion_px": 32,
          "separacion_seg": 0.3,
          "item": "rojo",
          "legacy_index": 0
        }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "source_commit",
    "aliases",
    "pending"
  ],
  "additionalProperties": false,
  "properties": {
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "aliases": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^w[0-9]{2}_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^w[0-9]{2}_[a-z0-9_]+$"
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "enemy",
          "world",
          "state",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "enemy": {
            "type": "string"
          },
          "world": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "state": {
            "const": "pending"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "examples": [
    {
      "source_commit": "9871b5a997408cd4ffec45b8a2b2b0593435537c",
      "aliases": {
        "w03_boss_boss_w03_tere_move": "w04_boss_boss_w04_tere_move"
      },
      "pending": [
        {
          "key": "w01_enemy_eulalia_hit",
          "enemy": "eulalia",
          "world": 1,
          "state": "pending",
          "reason": "No accepted original PNG/atlas for this species"
        }
      ]
    }
  ]
}
